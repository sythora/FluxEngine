@page "/"
@implements IAsyncDisposable
@inject IJSRuntime JS

<PageTitle>FluxRunner: Afterlight</PageTitle>

<main class="game-page">
    <header class="game-header">
        <a class="brand" href="/" aria-label="FluxRunner home"><span>F</span> FLUXRUNNER <i>/</i> AFTERLIGHT</a>
        <div class="header-right">
            <span class="edition"><span></span> C# WEBASSEMBLY EDITION</span>
            <button class="sound-toggle" @onclick="ToggleSound" aria-label="@(_game?.SoundEnabled == true ? "Turn sound off" : "Turn sound on")">
                @(_game?.SoundEnabled == true ? "♪" : "♫")
            </button>
        </div>
    </header>

    <section class="game-frame" aria-label="FluxRunner game">
        <div class="canvas-wrap">
            <canvas @ref="_canvas" width="960" height="540"
                    aria-label="FluxRunner: Afterlight. Use A and D or arrow keys to move. Press Space to jump twice. Escape pauses the game. Click canvas menus to play."></canvas>
            <div class="canvas-status"><span></span> @_status</div>
        </div>
        <div class="touch-controls" aria-label="Touch controls">
            <button class="touch-button move-button" aria-label="Move left"
                    @onpointerdown="() => SetTouchKey(Key.A, true)" @onpointerup="() => SetTouchKey(Key.A, false)"
                    @onpointercancel="() => SetTouchKey(Key.A, false)" @onpointerleave="() => SetTouchKey(Key.A, false)"
                    @onpointerdown:preventDefault="true">◀</button>
            <button class="touch-button move-button" aria-label="Move right"
                    @onpointerdown="() => SetTouchKey(Key.D, true)" @onpointerup="() => SetTouchKey(Key.D, false)"
                    @onpointercancel="() => SetTouchKey(Key.D, false)" @onpointerleave="() => SetTouchKey(Key.D, false)"
                    @onpointerdown:preventDefault="true">▶</button>
            <span class="touch-spacer"></span>
            <button class="touch-button menu-button" aria-label="Pause game"
                    @onpointerdown="() => SetTouchKey(Key.Escape, true)" @onpointerup="() => SetTouchKey(Key.Escape, false)"
                    @onpointercancel="() => SetTouchKey(Key.Escape, false)"
                    @onpointerdown:preventDefault="true">Ⅱ</button>
            <button class="touch-button jump-button" aria-label="Jump"
                    @onpointerdown="() => SetTouchKey(Key.Space, true)" @onpointerup="() => SetTouchKey(Key.Space, false)"
                    @onpointercancel="() => SetTouchKey(Key.Space, false)" @onpointerdown:preventDefault="true">JUMP</button>
        </div>
        <footer class="game-footer">
            <div class="game-stat"><span>ENGINE</span><strong>@_assemblyName · C#</strong></div>
            <div class="game-stat"><span>STORY</span><strong>@(_game is null ? "Starting" : $"{_game.CompletedChapters}/3 chapters")</strong></div>
            <p><kbd>A</kbd><kbd>D</kbd> MOVE <span>/</span> <kbd>SPACE</kbd> JUMP ×2 <span>/</span> <kbd>ESC</kbd> PAUSE</p>
        </footer>
    </section>

    <section class="feature-row" aria-label="Browser port features">
        <div><span class="feature-icon">✦</span><strong>THE WHOLE STORY</strong><p>Three chapters, archive memories, lantern checkpoints, and a real ending—running from the engine's C# game code.</p></div>
        <div><span class="feature-icon">◈</span><strong>BUILT FOR BROWSER</strong><p>Canvas rendering, synthesized Web Audio, local saves, reduced motion, high contrast, and touch controls.</p></div>
        <div><span class="feature-icon">⌘</span><strong>ENGINE-POWERED</strong><p>FluxEngine scenes, entities, rigidbody physics, collisions, input actions, camera, and fixed-timestep updates.</p></div>
    </section>
    <p class="fine-print">Progress and settings stay in this browser. Sound begins after your first interaction.</p>
</main>

@code {
    private readonly InputManager _input = new();
    private readonly Scene _scene = new();
    private readonly Queue<string> _touchKeyEvents = new();
    private readonly Queue<string> _pendingSaveJson = new();
    private ElementReference _canvas;
    private IJSObjectReference? _module;
    private DotNetObjectReference<Home>? _dotNetReference;
    private Renderer? _renderer;
    private SceneLoop? _loop;
    private BrowserFluxRunner? _game;
    private double _previousTimestamp;
    private float _uiRefreshTimer;
    private bool _disposed;
    private string _status = "LOADING GAME";
    private string _assemblyName = typeof(Scene).Assembly.GetName().Name ?? "FluxEngine";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./fluxEngineHost.js");
        _game = new BrowserFluxRunner(_scene, _input);
        _game.LoadSave(await _module.InvokeAsync<string?>("loadGameSave"));
        _game.SaveRequested += OnSaveRequested;
        _renderer = Renderer.CreateBrowser(BrowserFluxRunner.ViewWidth, BrowserFluxRunner.ViewHeight);
        _loop = new SceneLoop(_scene);
        _loop.Start();

        _dotNetReference = DotNetObjectReference.Create(this);
        await _module.InvokeVoidAsync("start", _canvas, _dotNetReference, BrowserFluxRunner.ViewWidth, BrowserFluxRunner.ViewHeight);
        _status = "READY TO PLAY";
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task OnAnimationFrame(
        double timestamp,
        string[] keyEvents,
        double[][] pointerEvents,
        double canvasWidth,
        double canvasHeight)
    {
        if (_disposed || _game is null || _loop is null || _renderer is null || _module is null)
            return;
        if (canvasWidth <= 0 || canvasHeight <= 0)
            return;

        _input.BeginFrame();
        foreach (var keyEvent in keyEvents)
            ApplyKeyEvent(keyEvent);
        while (_touchKeyEvents.TryDequeue(out var touchEvent))
            ApplyKeyEvent(touchEvent);

        foreach (var point in pointerEvents)
        {
            if (point.Length >= 2)
                _game.HandlePointer(point[0], point[1]);
        }

        var deltaTime = _previousTimestamp <= 0
            ? 0f
            : (float)Math.Clamp((timestamp - _previousTimestamp) / 1000d, 0d, 0.25d);
        _previousTimestamp = timestamp;

        _game.HandleInput(deltaTime);
        _loop.AdvanceFrame(deltaTime);
        _game.Update(deltaTime);
        _game.UpdateEffects(deltaTime);

        _renderer.BeginBrowserFrame(_scene.BackgroundColor);
        _scene.Draw(_renderer);
        _game.Draw(_renderer);

        var camera = _scene.Camera;
        await _module.InvokeVoidAsync(
            "drawFrame",
            _canvas,
            canvasWidth,
            canvasHeight,
            BrowserFluxRunner.ViewWidth,
            BrowserFluxRunner.ViewHeight,
            camera?.Position.X ?? 0,
            camera?.Position.Y ?? 0,
            camera?.Zoom ?? 1,
            _renderer.BrowserCommands);

        while (_pendingSaveJson.TryDequeue(out var saveJson))
            await _module.InvokeVoidAsync("saveGameSave", saveJson);
        await _module.InvokeVoidAsync("playGameSounds", _game.TakeSoundEvents(), _game.SoundEnabled);
        _uiRefreshTimer += deltaTime;
        if (_uiRefreshTimer >= 0.5f)
        {
            _uiRefreshTimer = 0;
            _status = _game.State switch
            {
                BrowserGameState.Playing => "SIGNAL ACTIVE",
                BrowserGameState.Dialogue => "STORY ARCHIVE",
                BrowserGameState.Paused => "PAUSED",
                BrowserGameState.Settings => "SETTINGS",
                BrowserGameState.GameOver => "RUN ENDED",
                BrowserGameState.Ending => "CAMPAIGN COMPLETE",
                _ => "READY TO PLAY",
            };
            await InvokeAsync(StateHasChanged);
        }
    }

    private void ApplyKeyEvent(string keyEvent)
    {
        var separator = keyEvent.LastIndexOf('|');
        if (separator <= 0 || !TryMapKey(keyEvent[..separator], out var key))
            return;

        _input.SetKey(key, keyEvent[(separator + 1)..] == "1");
    }

    private void SetTouchKey(Key key, bool pressed)
        => _touchKeyEvents.Enqueue($"{key}|{(pressed ? 1 : 0)}");

    private void ToggleSound()
    {
        if (_game is null)
            return;

        _game.ToggleSoundSetting();
    }

    private void OnSaveRequested(string json)
        => _pendingSaveJson.Enqueue(json);

    private static bool TryMapKey(string code, out Key key)
    {
        key = code switch
        {
            "ArrowLeft" => Key.Left,
            "ArrowRight" => Key.Right,
            "ArrowUp" => Key.Up,
            "ArrowDown" => Key.Down,
            "Space" => Key.Space,
            "Escape" => Key.Escape,
            "Enter" => Key.Enter,
            _ when code.StartsWith("Key", StringComparison.Ordinal) =>
                Enum.TryParse(code[3..], true, out Key parsed) ? parsed : Key.Unknown,
            _ when Enum.TryParse(code, true, out Key parsed) => parsed,
            _ => Key.Unknown,
        };
        return key != Key.Unknown;
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        _loop?.Stop();
        _scene.Clear();
        _dotNetReference?.Dispose();

        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("stop", _canvas);
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}
