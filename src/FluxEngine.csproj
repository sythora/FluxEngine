<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <AssemblyName>FluxEngine</AssemblyName>
    <RootNamespace>FluxEngine</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- the code uses plain comments, no xml docs, stop the noise -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="FluxEngine.Editor/**" />
  </ItemGroup>

  <!-- built-in bitmap fonts: BMFont text map + PNG atlas -->
  <ItemGroup>
    <EmbeddedResource Include="FluxEngine.Content\Fonts\*.fnt" />
    <EmbeddedResource Include="FluxEngine.Content\Fonts\*.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SDL2-CS" Version="2.0.0" GeneratePathProperty="true" />
    <PackageReference Include="StbImageSharp" Version="2.30.16" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="$(NuGetPackageRoot)sdl2-cs\2.0.0\content\net20\SDL2-CS\SDL2.cs" Link="SDL2\SDL2.cs" />
    <Compile Include="$(NuGetPackageRoot)sdl2-cs\2.0.0\content\net20\SDL2-CS\LPUtf8StrMarshaler.cs" Link="SDL2\LPUtf8StrMarshaler.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(OS)' == 'Windows_NT'">
    <Content Include="FluxEngine.Platform\runtimes\win-x64\native\SDL2.dll"
             Link="SDL2.dll"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest"
             Pack="true"
             PackagePath="runtimes\win-x64\native\" />
  </ItemGroup>

  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
</Project>
